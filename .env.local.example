# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it's already in .gitignore.

# From your Supabase project's Connect dialog (or Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The URL this site is running at. Used to build the magic-link login
# callback. For local development this is fine as-is; on Netlify, set it
# to your live site URL (e.g. https://godspeeddriving.netlify.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
